[Unit]
Description=Agent Smith daemon
After=network.target

[Service]
Type=simple
TimeoutSec=60
Restart=always
RestartSec=2
# The postman loop feeds the watchdog on each /home poll (every 1-20 s). A
# loop stuck for 10 minutes restarts smithd.
WatchdogSec=10min
NotifyAccess=main
User=root
# Creates /run/smithd for the local control socket and cleans it up on stop.
RuntimeDirectory=smithd
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/smithd
WorkingDirectory=/etc/smith
Environment="RUST_LOG=INFO"
EnvironmentFile=-/etc/smith/environment

[Install]
WantedBy=multi-user.target
