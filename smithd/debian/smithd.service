[Unit]
Description=Agent Smith daemon
After=network.target

[Service]
Type=simple
TimeoutSec=60
Restart=always
RestartSec=2
User=root
# Creates /run/smithd for the local control socket and cleans it up on stop.
RuntimeDirectory=smithd
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/smithd
WorkingDirectory=/etc/smith
Environment="RUST_LOG=INFO"
EnvironmentFile=-/etc/smith/environment

[Install]
WantedBy=multi-user.target
